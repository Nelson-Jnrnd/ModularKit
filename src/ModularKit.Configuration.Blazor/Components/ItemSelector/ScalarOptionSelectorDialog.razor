@using ModularKit.Configuration.View

<ItemSelectorDialogBase T="ScalarOption"
                        Items="Options"
                        SelectedItem="SelectedOption"
                        Title="@Title"
                        CanSelectNull="true"
                        SearchTextSelector="@(option => option.Label)">
    <ItemHeaderTemplate Context="option">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h6">
                @option.Label
            </MudText>

            @if (option.Badges is { Count: > 0 } badges)
            {
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    @foreach (ScalarOptionBadge badge in badges)
                    {
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Outlined"
                                 Color="@BadgeColor(badge.Kind)">
                            @badge.Text
                        </MudChip>
                    }
                </MudStack>
            }

            <MudDivider />
        </MudStack>
    </ItemHeaderTemplate>
</ItemSelectorDialogBase>

