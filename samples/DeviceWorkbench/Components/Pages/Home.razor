@page "/"
@using DeviceWorkbench.Contracts
@using ModularKit.Configuration.Blazor.Components.ConfigTree
@using ModularKit.Configuration.Blazor.Components.ConfigTree.ConfigNodes
@using ModularKit.Configuration.Serialization
@using ModularKit.Persistence.Json
@inject IJsonFileStore Store
@inject ISerializationOptionsProvider Json
@inject IWebHostEnvironment Environment
@inject ExamplePluginInfo PluginInfo

@using DeviceWorkbench.Theme

<PageTitle>Device workbench · ModularKit</PageTitle>
<MudThemeProvider Theme="WorkbenchTheme.Value" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<div class="workbench-page">
    <main class="workbench-shell">
        <header class="workbench-header">
            <div class="workbench-brand">
                <MudIcon Icon="@Icons.Material.Filled.Hub" />
                <span>ModularKit</span>
                <span class="workbench-example">Example</span>
            </div>
            <h1>Device workbench</h1>
            <p>Configure your devices, connections and references.</p>
        </header>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }
        @if (_root is not null)
        {
            <div class="workbench-toolbar">
                <div class="workbench-status" role="status">
                    <MudIcon Icon="@(_status == "Unsaved changes." ? Icons.Material.Outlined.Edit : Icons.Material.Outlined.CheckCircle)" Size="Size.Small" />
                    <span>@_status</span>
                </div>
                <div class="workbench-actions">
                    <MudButton OnClick="ReloadAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" Disabled="_saving">Reload</MudButton>
                    <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" DropShadow="false" Disabled="_saving">Save</MudButton>
                </div>
            </div>
            <div class="workbench-editor">
                <aside class="workbench-navigation" aria-label="Configuration tree">
                    <div class="workbench-navigation-title">Configuration</div>
                    <ConfigurationTree Root="_root" @bind-SelectedItem="_selected" />
                </aside>
                <section class="workbench-details" aria-label="Configuration details">
                    <ConfigurationPanelContainer SelectedItem="_selected" OnConfigChanged="Refresh"
                        OnItemAdded="SelectAdded" OnItemDeleted="Deleted" OnOpenRequested="Open" />
                </section>
            </div>
            <footer class="workbench-footer">
                <MudIcon Icon="@Icons.Material.Outlined.Extension" Size="Size.Small" />
                <span>@PluginInfo.Label</span>
            </footer>
        }
    </main>
</div>

@code {
    private Workbench _model = new() { Name = "Workbench" };
    private EntityConfigElement? _root;
    private ConfigElement? _selected;
    private string? _error;
    private string _status = string.Empty;
    private bool _saving;
    private FileInfo StorageFile => new(Path.Combine(Environment.ContentRootPath, "storage", "workbench.json"));

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            if (StorageFile.Exists)
                _model = await Store.LoadAsync<Workbench>(StorageFile, Json.Config, CancellationToken.None);
            _model.WireUp(null);
            _root = new EntityConfigElement(_model);
            _selected = _root;
            _error = null;
            _status = StorageFile.Exists ? "Configuration loaded." : "No saved configuration yet.";
        }
        catch (Exception exception) { _error = exception.Message; }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _model.PrepareConfigReferencesForPersistence();
            await Store.SaveAsync(_model, StorageFile, Json.Config, CancellationToken.None);
            _error = null;
            _status = "Configuration saved.";
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private void Refresh()
    {
        _model.WireUp(null);
        var selectedEntity = (_selected as EntityConfigElement)?.Data;
        _root!.RefreshFromDomain();
        _selected = selectedEntity is null ? _root : _root.FindInChildren(selectedEntity) ?? _root;
        _status = "Unsaved changes.";
    }

    private void Deleted() { _selected = _root; Refresh(); }
    private void Open(ModularKit.Configuration.ConfigEntity entity) => _selected = _root!.FindInChildren(entity);
    private void SelectAdded(ConfigElement element) =>
        _selected = element is EntityConfigElement entity ? _root!.FindInChildren(entity.Data) : element;
}
